{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": "mcuvms-laravel/**"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/mcuvms-laravel/public/assets/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/mcuvms-laravel/public/images/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/mcuvms-laravel/public/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/mcuvms-laravel/public/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "MCUVMS",
    "APP_ENV": "production",
    "APP_KEY": "base64:w0zSaIbqeTIzxs2iu7FeLH02rjc/CLnFSmyre2xMsCU=",
    "APP_DEBUG": "false",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr"
  }
}
