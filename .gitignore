# Laravel paths
# mcuvms-laravel/vendor/ (bundled for serverless deployment on Vercel)
mcuvms-laravel/node_modules/
mcuvms-laravel/.env
mcuvms-laravel/.env.backup
mcuvms-laravel/.env.production
mcuvms-laravel/storage/*.key
mcuvms-laravel/storage/framework/cache/*
!mcuvms-laravel/storage/framework/cache/.gitignore
mcuvms-laravel/storage/framework/sessions/*
!mcuvms-laravel/storage/framework/sessions/.gitignore
mcuvms-laravel/storage/framework/views/*
!mcuvms-laravel/storage/framework/views/.gitignore
mcuvms-laravel/storage/logs/*
!mcuvms-laravel/storage/logs/.gitignore
mcuvms-laravel/public/storage
mcuvms-laravel/public/build
